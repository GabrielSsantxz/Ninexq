ADMIN_PASSWORD=replace-with-a-strong-password
# Local frontend origin. In production, set this to the deployed site origin.
CLIENT_ORIGIN=http://localhost:5173
# Local Discord links only. In production, use the public HTTPS site URL.
FRIENDS_PUBLIC_URL=http://localhost:5173
NODE_ENV=development

# Configure these to enable the Discord integration.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_LOG_CHANNEL_ID=1569557281266344116

# Optional TURN server for WebRTC connectivity on restrictive networks.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
